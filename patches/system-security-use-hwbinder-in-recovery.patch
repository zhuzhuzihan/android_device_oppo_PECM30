From: OrangeFox PECM30 device maintainers
Subject: [PATCH] keystore2: use binderized HIDL manager in recovery

Recovery builds normally force generated HIDL getService() calls through the
passthrough transport. PECM30 recovery runs a binderized hwservicemanager, so
km_compat must obtain its context manager directly.

---
 keystore2/src/km_compat/km_compat.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/keystore2/src/km_compat/km_compat.cpp b/keystore2/src/km_compat/km_compat.cpp
index 0000000..0000000 100644
--- a/keystore2/src/km_compat/km_compat.cpp
+++ b/keystore2/src/km_compat/km_compat.cpp
@@ -24,6 +24,7 @@
 #include <aidl/android/system/keystore2/ResponseCode.h>
 #include <android-base/logging.h>
 #include <android/hidl/manager/1.2/IServiceManager.h>
+#include <hidl/ServiceManagement.h>
 #include <binder/IServiceManager.h>
 #include <hardware/keymaster_defs.h>
 #include <keymasterV4_1/Keymaster.h>
@@ -1311,7 +1312,7 @@ KeymasterDevices enumerateKeymasterDevices(IServiceManager* serviceManager) {
 }
 
 KeymasterDevices initializeKeymasters() {
-    auto serviceManager = IServiceManager::getService();
+    auto serviceManager = android::hardware::defaultServiceManager1_2();
     CHECK(serviceManager.get()) << "Failed to get ServiceManager";
     auto result = enumerateKeymasterDevices<Keymaster4>(serviceManager.get());
     auto softKeymaster = result[SecurityLevel::SOFTWARE];
-- 
2.34.1
