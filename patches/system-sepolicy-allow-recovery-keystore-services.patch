From: OrangeFox PECM30 device maintainers
Subject: [PATCH] sepolicy: allow recovery Keystore2 services

Keystore2 runs in the recovery domain and registers its AIDL services with
servicemanager. Map those names to a private recovery service type and allow
the recovery domain to publish them only in the recovery policy.

diff --git a/private/recovery.te b/private/recovery.te
index bba2a0d..2bd82a2 100644
--- a/private/recovery.te
+++ b/private/recovery.te
@@ -1,0 +2 @@ typeattribute recovery coredomain;
+type recovery_keystore_service, service_manager_type;
@@ -5,0 +7,3 @@ recovery_only(`
+  # Keystore2 runs in the recovery domain for FBE decryption.
+  allow recovery recovery_keystore_service:service_manager { add find };
+
diff --git a/private/service_contexts b/private/service_contexts
index 3fd342b..c359c8b 100644
--- a/private/service_contexts
+++ b/private/service_contexts
@@ -23 +23 @@ android.frameworks.stats.IStats/default                              u:object_r:
-android.system.keystore2.IKeystoreService/default                    u:object_r:keystore_service:s0
+android.system.keystore2.IKeystoreService/default                    u:object_r:recovery_keystore_service:s0
@@ -35,2 +35,2 @@ android.os.UpdateEngineStableService      u:object_r:update_engine_stable_servic
-android.security.apc                      u:object_r:apc_service:s0
-android.security.authorization            u:object_r:authorization_service:s0
+android.security.apc                      u:object_r:recovery_keystore_service:s0
+android.security.authorization            u:object_r:recovery_keystore_service:s0
@@ -40,4 +40,4 @@ android.security.keystore                 u:object_r:keystore_service:s0
-android.security.legacykeystore           u:object_r:legacykeystore_service:s0
-android.security.maintenance              u:object_r:keystore_maintenance_service:s0
-android.security.metrics                  u:object_r:keystore_metrics_service:s0
-android.security.remoteprovisioning       u:object_r:remoteprovisioning_service:s0
+android.security.legacykeystore           u:object_r:recovery_keystore_service:s0
+android.security.maintenance              u:object_r:recovery_keystore_service:s0
+android.security.metrics                  u:object_r:recovery_keystore_service:s0
+android.security.remoteprovisioning       u:object_r:recovery_keystore_service:s0
