on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.config adb

    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 root root

    # Stock vendor HALs (keymaster-4-0, gatekeeper-1-0, mobicore) need the
    # vendor library paths in their lookup chain.
    export LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64

    # Kick off the FBE decryption stack now that /vendor is first_stage_mount'd
    # from recovery.fstab. No external property is required.
    start decryption-hal-starter

on fs
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

service decryption-hal-starter /system/bin/sh -c "sleep 2; mount /dev/block/by-name/persist /mnt/vendor/persist; setprop ctl.start mobicore; sleep 2; setprop ctl.start keymaster-4-0; setprop ctl.start gatekeeper-1-0; sleep 2; setprop ctl.start keystore2"
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service mobicore /vendor/bin/mcDriverDaemon --P1 /mnt/vendor/persist/mcRegistry
    class core
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service.trustonic
    class early_hal
    user root
    group root drmrpc
    disabled
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class hal
    user root
    group root
    disabled
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    seclabel u:r:recovery:s0
