/boot emmc /dev/block/by-name/boot flags=backup=1;flashimg=1
/recovery emmc /dev/block/by-name/recovery flags=backup=1;flashimg=1
/cache ext4 /dev/block/by-name/cache flags=backup=1;wipeingui
/metadata ext4 /dev/block/by-name/metadata flags=backup=1;wipeingui
/data f2fs /dev/block/by-name/userdata flags=backup=1;wipeingui;formattable;fileencryption=aes-256-xts:aes-256-cts:v1
/persist ext4 /dev/block/by-name/persist flags=backup=1
/nvdata ext4 /dev/block/by-name/nvdata flags=backup=1
/nvcfg ext4 /dev/block/by-name/nvcfg flags=backup=1
/protect_f ext4 /dev/block/by-name/protect1 flags=backup=1
/protect_s ext4 /dev/block/by-name/protect2 flags=backup=1
/external_sd auto /dev/block/mmcblk1p1 flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg auto /dev/block/sdd1 flags=display="USB OTG";storage;wipeingui;removable
